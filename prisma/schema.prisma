generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ────────────────────────────────────────────────────────────────────
// Identity comes from Clerk (User.clerkId). Account, Session and
// VerificationToken are legacy NextAuth tables kept until a cleanup migration.

model User {
  id             String    @id @default(cuid())
  clerkId        String?   @unique
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  pendingOrgName String?

  accounts    Account[]
  sessions    Session[]
  memberships OrgMembership[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Organisation ─────────────────────────────────────────────────────────────

model Organisation {
  id                String    @id @default(cuid())
  name              String
  // Linked Clerk Organization (members, invites, billing live there).
  clerkOrgId        String?   @unique
  // Set when the org is deleted in Clerk: data is kept, the org is locked.
  deletedAt         DateTime?
  // Clerk Billing plan slug and the start of its current period (PR 3).
  planSlug          String?
  planPeriodStart   DateTime?
  // Billing details, edited by OWNERs on /dashboard/settings/billing-details.
  billingName       String?
  billingEmail      String?
  billingAddress1   String?
  billingAddress2   String?
  billingPostalCode String?
  billingCity       String?
  billingCountry    String? // ISO 3166-1 alpha-2
  billingVatId      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  members   OrgMembership[]
  profiles  Profile[]
  apiTokens ApiToken[]
  clusters  Cluster[]

  externalScanners ExternalScannerConnection[]
  externalScanRuns ExternalScanRun[]

  siemInstances    SiemInstance[]
  siemSubscription SiemSubscription?
}

enum OrgRole {
  OWNER
  MEMBER
}

model OrgMembership {
  id             String   @id @default(cuid())
  userId         String
  organisationId String
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
}

// ─── Scan Profiles ────────────────────────────────────────────────────────────

enum ProfileType {
  FULL
  SMALL
}

// A scanning profile belongs to an Organisation.
// FULL = deep scan all ports, SMALL = quick scan common ports.
model Profile {
  id             String      @id @default(cuid())
  organisationId String
  name           String
  type           ProfileType @default(SMALL)
  isDefault      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organisation     Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  targets          Target[]
  externalScanners ProfileExternalScanner[]

  @@index([organisationId])
}

// ─── Targets ─────────────────────────────────────────────────────────────────

enum TargetType {
  ip
  dns
}

enum ScannerStatus {
  READY_TO_DEPLOY
  DEPLOYED
  LOCAL
}

enum ReachabilityStatus {
  UP
  DOWN
  UNKNOWN
}

// A target is an IP or DNS entry attached to a profile.
model Target {
  id                 String             @id @default(cuid())
  profileId          String
  value              String // e.g. "192.168.1.1" or "example.com"
  type               TargetType
  label              String? // optional human-readable name
  port               Int? // optional port override
  scannerStatus      ScannerStatus      @default(READY_TO_DEPLOY)
  reachabilityStatus ReachabilityStatus @default(UP)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  clusterId String? // the cluster whose operator added it (X-Samma-Cluster)

  profile Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  cluster Cluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)

  externalScanRuns ExternalScanRun[]

  @@index([profileId])
  @@index([clusterId])
}

// ─── Clusters ────────────────────────────────────────────────────────────────

// A Kubernetes cluster running the samma operator or collector. It is created
// and kept alive by API calls that carry `X-Samma-Cluster: <name>`; its status
// (Ready/Down) is derived from lastSeenAt when read (src/lib/clusters.ts).
model Cluster {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  version        String? // X-Samma-Version of the last call
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  targets      Target[]

  @@unique([organisationId, name])
}

// ─── API Tokens ───────────────────────────────────────────────────────────────

// An API token for machine-to-machine access (e.g. scanner posting results).
// The raw token is shown once; only the SHA-256 hash is stored.
model ApiToken {
  id             String    @id @default(cuid())
  organisationId String
  name           String // human-readable label, e.g. "CI pipeline"
  tokenHash      String    @unique // SHA-256(rawToken), hex-encoded
  readOnly       Boolean   @default(false) // read-only tokens are rejected by write endpoints
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([tokenHash])
}

// ─── External Scanners ────────────────────────────────────────────────────────

// A connection from an org to a third-party scanner from the catalog in
// src/lib/external-scanners.ts. The vendor API key is outbound (Samma sends it
// to the vendor), so it is encrypted with AES-256-GCM (src/lib/secret-box.ts),
// not hashed. The price is snapshotted at connect time.
model ExternalScannerConnection {
  id                String   @id @default(cuid())
  organisationId    String
  scannerId         String // catalog id, e.g. "samma-demo"
  name              String
  apiKeyEncrypted   String // iv:tag:ciphertext, base64
  apiKeyLast4       String
  pricePerScanCents Int
  currency          String   @default("USD")
  createdAt         DateTime @default(now())

  organisation Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  profiles     ProfileExternalScanner[]
  runs         ExternalScanRun[]

  @@unique([organisationId, name])
  @@index([organisationId])
}

// Enables an external scanner connection on a profile (the target group):
// each run scans every target in the profile, at pricePerScanCents per target.
model ProfileExternalScanner {
  profileId    String
  connectionId String
  enabledAt    DateTime @default(now())

  profile    Profile                   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  connection ExternalScannerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@id([profileId, connectionId])
  @@index([connectionId])
}

enum ExternalScanStatus {
  RUNNING
  COMPLETED
  FAILED
}

// One scan of one target by an external scanner connection. Samma starts it
// (POST {apiUrl}/scans), stores the scanner's uuid as externalId, and fetches
// the result (GET {apiUrl}/scans/<uuid>) when a page that shows it is opened
// (src/lib/external-scans.ts). Only application/json results are accepted.
model ExternalScanRun {
  id             String             @id @default(cuid())
  organisationId String
  connectionId   String
  targetId       String
  externalId     String? // uuid from the external scanner; null if starting failed
  status         ExternalScanStatus @default(RUNNING)
  trigger        String // "new-target" | "rescan"
  requestedAt    DateTime           @default(now())
  finishedAt     DateTime?
  lastPolledAt   DateTime?
  contentType    String?
  result         Json?
  findingCount   Int                @default(0)
  error          String?

  organisation Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  connection   ExternalScannerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  target       Target                    @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([organisationId, status])
  @@index([targetId])
}

// ─── SIEM ─────────────────────────────────────────────────────────────────────

// How a SIEM was created. ANKRA_* deploys are mocked for now: nothing is
// provisioned, the status is derived from createdAt (src/lib/siem.ts).
enum SiemHosting {
  ANKRA_SAMMA // Ankra, on hosting Samma supports
  ANKRA_OWN // Ankra, on hosting the customer chooses
  CONNECTED // a SIEM the customer already runs
}

// A SIEM that belongs to an org. The SIEM key is inbound (the SIEM will send
// it to Samma), so only its SHA-256 hash is stored; the raw key is shown once.
// It is not an ApiToken, so it cannot call the /api/v1 findings/targets routes.
// Alert counts and rulesets are demo data until a SIEM reports in.
model SiemInstance {
  id             String      @id @default(cuid())
  organisationId String
  name           String
  hosting        SiemHosting
  provider       String? // ANKRA_OWN: hosting provider id, see src/lib/siem.ts
  region         String?
  apiKeyHash     String      @unique // SHA-256(rawKey), hex-encoded
  apiKeyLast4    String
  rulesetVersion String? // reported by the SIEM; null until it reports
  lastSeenAt     DateTime?
  createdAt      DateTime    @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, name])
  @@index([organisationId])
}

// The org's subscription to Samma detection rules. No billing yet: set by
// hand (SQL / Prisma Studio).
model SiemSubscription {
  id             String    @id @default(cuid())
  organisationId String    @unique
  plan           String // e.g. "rules-standard"
  active         Boolean   @default(true)
  startedAt      DateTime  @default(now())
  renewsAt       DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}
