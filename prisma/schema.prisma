generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth models ──────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  pendingOrgName String?

  accounts    Account[]
  sessions    Session[]
  memberships OrgMembership[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Organisation ─────────────────────────────────────────────────────────────

model Organisation {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   OrgMembership[]
  profiles  Profile[]
  apiTokens ApiToken[]
  clusters  Cluster[]

  externalScanners ExternalScannerConnection[]
}

enum OrgRole {
  OWNER
  MEMBER
}

model OrgMembership {
  id             String   @id @default(cuid())
  userId         String
  organisationId String
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
}

// ─── Scan Profiles ────────────────────────────────────────────────────────────

enum ProfileType {
  FULL
  SMALL
}

// A scanning profile belongs to an Organisation.
// FULL = deep scan all ports, SMALL = quick scan common ports.
model Profile {
  id             String      @id @default(cuid())
  organisationId String
  name           String
  type           ProfileType @default(SMALL)
  isDefault      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organisation     Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  targets          Target[]
  externalScanners ProfileExternalScanner[]

  @@index([organisationId])
}

// ─── Targets ─────────────────────────────────────────────────────────────────

enum TargetType {
  ip
  dns
}

enum ScannerStatus {
  READY_TO_DEPLOY
  DEPLOYED
  LOCAL
}

enum ReachabilityStatus {
  UP
  DOWN
  UNKNOWN
}

// A target is an IP or DNS entry attached to a profile.
model Target {
  id                 String             @id @default(cuid())
  profileId          String
  value              String // e.g. "192.168.1.1" or "example.com"
  type               TargetType
  label              String? // optional human-readable name
  port               Int? // optional port override
  scannerStatus      ScannerStatus      @default(READY_TO_DEPLOY)
  reachabilityStatus ReachabilityStatus @default(UP)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  clusterId String? // the cluster whose operator added it (X-Samma-Cluster)

  profile Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  cluster Cluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)

  @@index([profileId])
  @@index([clusterId])
}

// ─── Clusters ────────────────────────────────────────────────────────────────

// A Kubernetes cluster running the samma operator or collector. It is created
// and kept alive by API calls that carry `X-Samma-Cluster: <name>`; its status
// (Ready/Down) is derived from lastSeenAt when read (src/lib/clusters.ts).
model Cluster {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  version        String? // X-Samma-Version of the last call
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  targets      Target[]

  @@unique([organisationId, name])
}

// ─── API Tokens ───────────────────────────────────────────────────────────────

// An API token for machine-to-machine access (e.g. scanner posting results).
// The raw token is shown once; only the SHA-256 hash is stored.
model ApiToken {
  id             String    @id @default(cuid())
  organisationId String
  name           String // human-readable label, e.g. "CI pipeline"
  tokenHash      String    @unique // SHA-256(rawToken), hex-encoded
  readOnly       Boolean   @default(false) // read-only tokens are rejected by write endpoints
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([tokenHash])
}

// ─── External Scanners ────────────────────────────────────────────────────────

// A connection from an org to a third-party scanner from the catalog in
// src/lib/external-scanners.ts. The vendor API key is outbound (Samma sends it
// to the vendor), so it is encrypted with AES-256-GCM (src/lib/secret-box.ts),
// not hashed. The price is snapshotted at connect time.
model ExternalScannerConnection {
  id                String   @id @default(cuid())
  organisationId    String
  scannerId         String // catalog id, e.g. "samma-demo"
  name              String
  apiKeyEncrypted   String // iv:tag:ciphertext, base64
  apiKeyLast4       String
  pricePerScanCents Int
  currency          String   @default("USD")
  createdAt         DateTime @default(now())

  organisation Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  profiles     ProfileExternalScanner[]

  @@unique([organisationId, name])
  @@index([organisationId])
}

// Enables an external scanner connection on a profile (the target group):
// each run scans every target in the profile, at pricePerScanCents per target.
model ProfileExternalScanner {
  profileId    String
  connectionId String
  enabledAt    DateTime @default(now())

  profile    Profile                   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  connection ExternalScannerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@id([profileId, connectionId])
  @@index([connectionId])
}
