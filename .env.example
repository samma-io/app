# Samma.io app environment. Copy to .env and fill in the values.
# See README.md ("Environment Variables") for the full documentation.

# Main PostgreSQL connection string (hostname is the docker-compose service name)
DATABASE_URL=postgresql://samma:samma@postgres:5432/samma

# Scanner results TimescaleDB connection string (optional — safe to leave unset in dev)
SCANNER_DATABASE_URL=

# Public URL of the app
NEXTAUTH_URL=http://localhost:3000

# Random secret for session signing (e.g. openssl rand -base64 32)
NEXTAUTH_SECRET=

# SMTP server for magic link emails
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=25
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=

# URL of the Kubernetes operator Flask API (optional — leave unset in development)
OPERATOR_API_URL=

# Shared secret with the operator API, server-side only. Required whenever
# OPERATOR_API_URL is set. Must NOT be prefixed with NEXT_PUBLIC_ (it would be
# exposed to the client bundle).
OPERATOR_API_TOKEN=
