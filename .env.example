# Samma.io dashboard — copy to .env and fill in the values.

# ─── Database ────────────────────────────────────────────────────────────────

# Main PostgreSQL connection string.
# Inside docker compose the host is "postgres"; when running Prisma from the
# host machine, point at localhost:5432 instead (see README).
DATABASE_URL="postgresql://samma:samma@postgres:5432/samma"

# Scanner results TimescaleDB connection string (optional in development)
SCANNER_DATABASE_URL=

# ─── NextAuth ────────────────────────────────────────────────────────────────

# Public URL of the app
NEXTAUTH_URL="http://localhost:3000"

# Random secret for session signing (e.g. openssl rand -base64 32)
NEXTAUTH_SECRET=

# ─── SMTP (magic link emails) ────────────────────────────────────────────────

# SMTP host for magic link emails
EMAIL_SERVER_HOST=

# SMTP port
EMAIL_SERVER_PORT=

# SMTP username
EMAIL_SERVER_USER=

# SMTP password
EMAIL_SERVER_PASSWORD=

# From address for magic link emails
EMAIL_FROM=

# ─── Operator API ────────────────────────────────────────────────────────────

# URL of the Kubernetes operator Flask API (leave unset in development)
OPERATOR_API_URL=

# Bearer token for the operator API — shared secret with the operator API,
# server-side only (no NEXT_PUBLIC_ prefix, never sent to the client).
# Required whenever OPERATOR_API_URL is set.
OPERATOR_API_TOKEN=
