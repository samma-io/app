# Samma.io app environment. Copy to .env and fill in the values.
# See README.md ("Environment Variables") for the full documentation.

# Main PostgreSQL connection string (hostname is the docker-compose service name)
DATABASE_URL=postgresql://samma:samma@postgres:5432/samma

# Scanner results TimescaleDB connection string (optional — safe to leave unset in dev)
SCANNER_DATABASE_URL=

# Clerk authentication (https://dashboard.clerk.com → API keys)
# Publishable key is public and inlined into the client bundle at build time.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret key — server-side only, never prefix with NEXT_PUBLIC_.
CLERK_SECRET_KEY=
# Signing secret of the Clerk webhook endpoint (/api/webhooks/clerk), for org sync
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# URL of the Kubernetes operator Flask API (optional — leave unset in development)
OPERATOR_API_URL=

# Shared secret with the operator API, server-side only. Required whenever
# OPERATOR_API_URL is set. Must NOT be prefixed with NEXT_PUBLIC_ (it would be
# exposed to the client bundle).
OPERATOR_API_TOKEN=

# Key that encrypts external scanner vendor API keys (AES-256-GCM), server-side
# only. 32 bytes, base64: openssl rand -base64 32. Optional — without it,
# external scanners cannot be connected.
SCANNER_SECRET_KEY=
# Where to call the samma-demo external scanner (overrides the catalog apiUrl in src/lib/external-scanners.ts).
# EXTERNAL_SCANNER_URL_SAMMA_DEMO=http://172.17.0.1:8080

# ── Samma rule exchange (docs/siem-exchange.md). All optional; unset = off. ──
# Bearer token the detection-engine CI uses for POST /api/v1/siem/releases
# (at least 32 chars): openssl rand -hex 32
SIEM_PUBLISH_TOKEN=
# Public half of the OFFLINE rules signing key (Ed25519), base64 SPKI DER or PEM.
# Uploads that do not verify with it are refused. The private half never comes here.
SIEM_RULES_PUBLIC_KEY=
# Private key the app signs the community blocklist with (Ed25519), base64
# PKCS8 DER or PEM: openssl genpkey -algorithm ed25519 -outform DER | base64 -w0
SIEM_BLOCKLIST_SIGNING_KEY=
# Organisations that must report an IP before it is published (default 3).
# SIEM_BLOCKLIST_MIN_ORGS=3
# Comma-separated IPv4 CIDRs never published, e.g. CDN ranges.
# SIEM_BLOCKLIST_EXCLUDE=
