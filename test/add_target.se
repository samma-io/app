if [ -z "${SAMMA_API_TOKEN:-}" ]; then
  echo "error: SAMMA_API_TOKEN is not set. Export it before running this script." >&2
  exit 1
fi

curl -X POST http://localhost:3000/api/v1/targets \
  -H "Authorization: Bearer $SAMMA_API_TOKEN" \
  -H "Content-Type: application/json" \
  -d '{
    "value": "www.utbild.se",
    "type": "dns",
    "label": "Main server",
    "profileId": "cmnebts200006i4u5oktydnfx"
  }'
